{
  "name": "fleet-platform",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "seed": "node tools/seed-traccar.mjs && pnpm --filter server seed",
    "simulate": "node tools/simulate-gps.mjs",
    "dev:server": "pnpm --filter server dev",
    "dev:web": "pnpm --filter web dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build"
  }
}
