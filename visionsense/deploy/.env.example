# Copy to .env and change the passwords before deploying.
POSTGRES_DB=visionsense
POSTGRES_USER=visionsense
POSTGRES_PASSWORD=change-me

# Image to run; built by `docker compose build` when not pulled from a registry.
VS_IMAGE=aigc/visionsense:4.3.1.7
# build = compile from source inside Docker; prebuilt = package deploy/thingsboard.jar
VS_JAR_SOURCE=build

# true on the first install to load demo users and devices
LOAD_DEMO=false

VS_HTTP_PORT=8080
VS_MQTT_PORT=1883
VS_COAP_PORT=5683
VS_JAVA_OPTS=-Xms1g -Xmx2g
