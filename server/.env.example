# Copy to your deployment's environment (or a secret manager). Never commit real values.
DATABASE_URL=postgres://fleet:fleet@localhost:5432/erp
TRACCAR_URL=http://localhost:8082
HOOK_SECRET=change-me
SECRET_KEY=change-me-to-a-long-random-string
PORT=3000

# AI (optional): turns on the copilot, AI Ops and document reading
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Daily AI briefing after this hour, IST (optional); needs a Traccar login to read fleet data
AI_BRIEFING_HOUR=
TRACCAR_SERVICE_EMAIL=
TRACCAR_SERVICE_PASSWORD=

# Integrations (optional)
VAHAN_API_URL=
VAHAN_API_KEY=
FASTAG_API_URL=
FASTAG_API_KEY=
DASHCAM_STREAM_URL=
FLESPI_API_URL=https://flespi.io
MAX_UPLOAD_BYTES=8388608
